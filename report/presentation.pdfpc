{"pdfpcFormat":2,"disableMarkdown":false,"pages":[{"idx":0,"label":"1","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":1,"label":"2","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":2,"label":"3","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":3,"label":"4","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":4,"label":"5","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":5,"label":"6","overlay":0,"forcedOverlay":false,"hidden":false,"note":"Théorème d'Euler : a^(φ(n)) ≡ 1 mod n pour a premier avec n"},{"idx":6,"label":"7","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":7,"label":"8","overlay":0,"forcedOverlay":false,"hidden":false,"note":"\r\n  - Établissement canal sécurisé\r\n  - Échange client-serveur\r\n  - Attaquant envoie des messages chiffrés au serveur et mesure le temps de déchiffrement\r\n"},{"idx":8,"label":"9","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":9,"label":"10","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":10,"label":"11","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":11,"label":"12","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":12,"label":"13","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":13,"label":"14","overlay":0,"forcedOverlay":false,"hidden":false,"note":" - c incorrect\r\n  - Toutes les étapes suivantes sont incorrectes"},{"idx":14,"label":"15","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":15,"label":"16","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":16,"label":"17","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":17,"label":"18","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":18,"label":"19","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":19,"label":"20","overlay":0,"forcedOverlay":false,"hidden":false,"note":" - Désactivation du garbage collector\r\n  - Répétition des mesures de temps\r\n  - Phase de warm-up\r\n  - Utilisation de l'estimateur minimum plutôt que la moyenne\r\n"},{"idx":20,"label":"21","overlay":0,"forcedOverlay":false,"hidden":false,"note":" - Warm-up phase pour réduire l'impact du cache et de la prédiction de branchement\r\n  - Pas nécessaire car utilisation du minimum\r\n"},{"idx":21,"label":"22","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":22,"label":"23","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":23,"label":"24","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":24,"label":"25","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":25,"label":"26","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":26,"label":"27","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":27,"label":"28","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":28,"label":"29","overlay":0,"forcedOverlay":false,"hidden":false,"note":" - Derniers 30 bits de $p$ et $q$ qui diffèrent\r\n  - Temps pour trouver le gap: 3h\r\n  - Temps pour trouver les facteurs: moins de 1s"},{"idx":29,"label":"30","overlay":0,"forcedOverlay":false,"hidden":false},{"idx":30,"label":"31","overlay":0,"forcedOverlay":false,"hidden":false,"note":" - Serveurs sont vieux, moins optimisés et programmés en langage de bas niveau (C, C++)\r\n  - RSA est encore largement utilisé\r\n  - TLS 1.3 a supprimé les suites de chiffrement basées sur RSA, mais de nombreux serveurs supportent encore TLS 1.2 et des versions antérieures"},{"idx":31,"label":"32","overlay":0,"forcedOverlay":false,"hidden":false}]}
